---
/**
 * Figure 1 of Vaswani et al. (2017), redrawn: encoder on the left, decoder on
 * the right, N = 6 of each in the base model.
 */
const box = (x: number, y: number, w: number, h: number, label: string, cls = '') => ({ x, y, w, h, label, cls });
const enc = [
  box(52, 118, 186, 26, 'Add & Norm', 'norm'),
  box(52, 150, 186, 36, 'Feed forward', 'ff'),
  box(52, 200, 186, 26, 'Add & Norm', 'norm'),
  box(52, 232, 186, 36, 'Multi-head attention', 'att'),
];
const dec = [
  box(412, 58, 186, 26, 'Add & Norm', 'norm'),
  box(412, 90, 186, 36, 'Feed forward', 'ff'),
  box(412, 140, 186, 26, 'Add & Norm', 'norm'),
  box(412, 172, 186, 36, 'Multi-head attention', 'att'),
  box(412, 222, 186, 26, 'Add & Norm', 'norm'),
  box(412, 254, 186, 36, 'Masked multi-head attention', 'att'),
];
---

<figure class="cx-diagram" aria-label="The Transformer: an encoder stack and a decoder stack">
  <svg viewBox="0 0 680 440" role="img">
    <title>The Transformer, after Vaswani et al. 2017, figure 1</title>
    <defs>
      <marker id="tf-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0L8 4L0 8z" class="fill-ink"></path>
      </marker>
    </defs>
    <!-- stacks -->
    <rect x="38" y="104" width="214" height="180" class="stack"></rect>
    <text x="20" y="200" class="nx">N×</text>
    <rect x="398" y="44" width="214" height="262" class="stack"></rect>
    <text x="630" y="180" class="nx">×N</text>
    {
      [...enc, ...dec].map((b) => (
        <g class={`blk blk--${b.cls}`}>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="3" />
          <text x={b.x + b.w / 2} y={b.y + b.h / 2 + 4}>
            {b.label}
          </text>
        </g>
      ))
    }
    <!-- inputs -->
    <g class="blk blk--emb"><rect x="52" y="330" width="186" height="30" rx="3"></rect><text x="145" y="349">Input embedding</text></g>
    <g class="blk blk--emb"><rect x="412" y="330" width="186" height="30" rx="3"></rect><text x="505" y="349">Output embedding</text></g>
    <circle cx="145" cy="306" r="10" class="plus"></circle><text x="145" y="310" class="op">+</text>
    <circle cx="505" cy="312" r="10" class="plus"></circle><text x="505" y="316" class="op">+</text>
    <text x="162" y="310" class="note">positional encoding</text>
    <text x="488" y="316" class="note" text-anchor="end">positional encoding</text>
    <text x="145" y="388" class="io">inputs</text>
    <text x="505" y="388" class="io">outputs (shifted right)</text>
    <!-- output head -->
    <g class="blk blk--out"><rect x="440" y="6" width="130" height="24" rx="3"></rect><text x="505" y="22">Linear → softmax</text></g>
    <!-- flow arrows -->
    <path d="M145 376V362 M145 330V317 M145 296V270 M145 232V228 M145 200V188 M145 150V146" class="flow" marker-end="url(#tf-arrow)"></path>
    <path d="M505 376V362 M505 330V323 M505 302V292 M505 254V250 M505 222V210 M505 172V168 M505 140V128 M505 90V86 M505 58V32" class="flow" marker-end="url(#tf-arrow)"></path>
    <!-- encoder output into the decoder's cross-attention -->
    <path d="M145 118V96H330V190H410" class="flow flow--cross" marker-end="url(#tf-arrow)"></path>
    <text x="152" y="90" class="note">keys and values from the encoder</text>
    <!-- residuals -->
    <path d="M44 296V213H50 M44 213V131H50" class="res"></path>
    <path d="M404 300V235H410 M404 235V153H410 M404 153V71H410" class="res"></path>
    <text x="340" y="420" class="caption-in" text-anchor="middle">d_model = 512 · h = 8 heads of d_k = d_v = 64 · d_ff = 2048 · N = 6</text>
  </svg>
</figure>

<style>
  .cx-diagram {
    margin: 2.4em calc(-1 * min(var(--pad), 2rem));
    padding: 12px;
    border: 1px solid rgba(22, 20, 15, 0.25);
    background: var(--paper);
    background-image: radial-gradient(rgba(22, 20, 15, 0.08) 1px, transparent 1.2px);
    background-size: 12px 12px;
  }
  .cx-diagram svg {
    width: 100%;
    height: auto;
    font-family: var(--f-mono);
    font-size: 11px;
  }
  .stack {
    fill: none;
    stroke: var(--ink);
    stroke-dasharray: 3 3;
  }
  .nx {
    font-size: 14px;
    fill: var(--ink);
    text-anchor: middle;
  }
  .blk rect {
    fill: var(--paper);
    stroke: var(--ink);
  }
  .blk text {
    text-anchor: middle;
    fill: var(--ink);
  }
  .blk--att rect {
    fill: color-mix(in srgb, var(--c-np) 18%, var(--paper));
  }
  .blk--ff rect {
    fill: color-mix(in srgb, var(--c-p) 16%, var(--paper));
  }
  .blk--norm rect {
    fill: var(--paper-2);
  }
  .blk--emb rect,
  .blk--out rect {
    fill: color-mix(in srgb, var(--c-exp) 14%, var(--paper));
  }
  .plus {
    fill: var(--paper);
    stroke: var(--ink);
  }
  .op {
    text-anchor: middle;
    font-size: 14px;
    fill: var(--ink);
  }
  .note,
  .io {
    fill: var(--ink-2);
  }
  .io {
    text-anchor: middle;
  }
  .flow {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
  }
  .flow--cross {
    stroke: var(--c-np);
  }
  .res {
    fill: none;
    stroke: var(--ink-2);
    stroke-dasharray: 2 3;
  }
  :global(.fill-ink) {
    fill: var(--ink);
  }
  .caption-in {
    fill: var(--ink-2);
  }
</style>
