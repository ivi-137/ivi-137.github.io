---
/**
 * Results of the toy experiment, drawn at build time from
 * research/coherence/results/summary.json (written by aggregate.py).
 */
import summary from '../../../research/coherence/results/summary.json';
import hazards from '../../../research/coherence/results/hazards.json';
import screen from '../../../research/coherence/results/screen/summary.json';

interface Props {
  chart: 'bars' | 'bylen' | 'hazard' | 'rising' | 'attention' | 'monitors' | 'cost' | 'placement' | 'productlaw';
  caption?: string;
}
const { chart, caption } = Astro.props;

type S = { mean: number; min: number; max: number; sd: number; n: number } | null;
const V = summary.variants as Record<string, any>;
// the placement screen: 400 steps, one seed, 100 prompts; never mixed with the full runs
const SV = (screen as any).variants as Record<string, any>;
const NAME: Record<string, string> = {
  base: 'baseline',
  base_aux: 'baseline + same labels',
  ledger: 'Ledger',
  ledger_joint: 'Ledger, one shared softmax',
  ledger_nogate: 'Ledger, no eos gate',
  ledger_nosup: 'Ledger, no monitor labels',
  base_frame: 'baseline + frame',
  ledger_frame: 'Ledger + frame',
  ledger_frame_evict: 'Ledger + frame, examples dropped',
  ledger_pre: 'Ledger read before attention',
  ledger_top: 'Ledger read in the top layer only',
  ledger_film: 'Ledger as modulation',
  ledger_logit: 'Ledger on the logits only',
};
const PLACES: [string, string][] = [
  ['base', 'nowhere: the baseline'],
  ['ledger_joint', 'before: in the context'],
  ['ledger_pre', 'inside, before attention'],
  ['ledger', 'inside, after attention'],
  ['ledger_top', 'inside, top layer only'],
  ['ledger_film', 'inside, as modulation'],
  ['ledger_logit', 'after: logits only'],
];
const COLOR: Record<string, string> = {
  base: 'var(--c-exp)',
  base_aux: 'var(--violet)',
  ledger: 'var(--c-p)',
  ledger_joint: 'var(--c-np)',
  ledger_nogate: 'var(--ink-2)',
  ledger_nosup: '#b98a00',
  base_frame: '#b0508a',
  ledger_frame: '#0d7a5f',
  ledger_frame_evict: 'var(--ink)',
};
const order = ['base', 'base_aux', 'base_frame', 'ledger_nosup', 'ledger_nogate', 'ledger_joint', 'ledger', 'ledger_frame', 'ledger_frame_evict'].filter((v) => V[v]);
const tableOrder = ['base', 'base_aux', 'base_frame', 'ledger_joint', 'ledger', 'ledger_frame', 'ledger_frame_evict'].filter((v) => V[v]);
const pct = (x: number) => `${Math.round(x * 100)}%`;
const W = 680;

// bars
const bars = order.map((v, i) => ({ v, i, all: V[v].all.coherent as S, conf: V[v].conflict.coherent as S }));
const bx = (x: number) => 232 + x * 300;

// lines over k
const ks = Object.keys(V.base?.by_k ?? {}).map(Number);
const lineVariants = ['base', 'base_aux', 'ledger', 'ledger_frame_evict'].filter((v) => V[v]);
const kx = (k: number) => 60 + ((k - ks[0]) / (ks[ks.length - 1] - ks[0] || 1)) * (W - 100);
const ky = (y: number) => 220 - y * 190;
const path = (pts: [number, number][]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join('');

// hazards per opportunity, with 95% Wilson intervals (analyze.py)
const HZ = hazards as Record<string, any>;
const hzVariants = ['base', 'base_aux', 'ledger', 'ledger_frame'].filter((v) => HZ[v]);
const kinds = ['font', 'heading', 'math'];
const KIND_LABEL: Record<string, string> = { font: 'font (every paragraph)', heading: 'headings (every section)', math: 'maths (a formula now and then)' };
const hzMax = Math.max(0.01, ...hzVariants.flatMap((v) => kinds.map((k) => HZ[v][k].ci[1])));
const hx = (x: number) => 230 + (x / hzMax) * (W - 390);
const fmtHz = (x: number) => `${(x * 100).toFixed(x < 0.01 ? 2 : 1)}%`;
// font hazard by paragraph
const bins = (HZ.base?.font_by_paragraph ?? []) as { from: number; to: number }[];
const rMax = Math.max(0.005, ...['base', 'ledger'].filter((v) => HZ[v]).flatMap((v) => HZ[v].font_by_paragraph.map((b: any) => b.hazard)));
const rx = (i: number) => 90 + i * ((W - 160) / Math.max(1, bins.length - 1));
const ry = (y: number) => 210 - (y / rMax) * 170;

// attention
// offsets no post reached come back as 0: they are missing data, not zero attention, so stop there
const att = (v: string) => {
  const a = ((V[v]?.attention ?? []) as number[]).slice(0, 101);
  const end = a.findIndex((x) => x === 0);
  return end < 0 ? a : a.slice(0, end);
};
const amax = Math.max(0.05, ...att('base'), ...att('ledger'));
const ax = (t: number) => 60 + (t / 100) * (W - 100);
const ay = (y: number) => 220 - (y / amax) * 190;

/** A legend below the axis: a short line in each series' colour, then its name; wraps to a new row. */
const legend = (vs: string[], y0: number) => {
  let x = 60, y = y0;
  return vs.map((v) => {
    const w = 22 + NAME[v].length * 6.7 + 26;
    if (x + w > W - 10) (x = 60), (y += 17);
    const it = { v, x, y };
    x += w;
    return it;
  });
};
const legendRows = (vs: string[]) => new Set(legend(vs, 0).map((i) => i.y)).size;

const MON = ['font', 'heading', 'math', 'why', 'sources', 'order', 'form', 'length', 'coherent'];
const MON_LABEL: Record<string, string> = { font: 'font', heading: 'headings', math: 'maths', why: 'why-section', sources: 'sources last', order: 'order', form: 'form', length: 'length (explicit)', coherent: 'all seven implicit' };
const kmacs = (x: number) => `${Math.round(x / 1000)}k`;
const baseCost = V.base?.macs_per_token;
---

{
  chart === 'productlaw' ? (
    <table class="cx-table">
      <thead>
        <tr>
          <th>model</th>
          <th>font</th>
          <th>headings</th>
          <th>maths</th>
          <th>all three</th>
        </tr>
      </thead>
      <tbody>
        {['base', 'base_aux', 'ledger_joint', 'ledger'].filter((v) => HZ[v]?.product_law).map((v) => {
          const pl = HZ[v].product_law;
          const cell = (p: number, m: number) => (
            <td>
              {(100 * p).toFixed(1)} <small>/ {(100 * m).toFixed(1)}</small>
            </td>
          );
          return (
            <tr>
              <td>{NAME[v]}</td>
              {cell(pl.predicted.font, pl.measured.font)}
              {cell(pl.predicted.heading, pl.measured.heading)}
              {cell(pl.predicted.math, pl.measured.math)}
              {cell(pl.joint_predicted, pl.joint_measured)}
            </tr>
          );
        })}
      </tbody>
    </table>
  ) : chart === 'placement' ? (
    <table class="cx-table">
      <thead>
        <tr>
          <th>where</th>
          <th>coherent</th>
          <th>why-section</th>
          <th>sources last</th>
          <th>length</th>
          <th>Ledger operations per token</th>
        </tr>
      </thead>
      <tbody>
        {PLACES.filter(([v]) => SV[v]).map(([v, where]) => (
          <tr>
            <td>{where}</td>
            <td>{pct(SV[v].all.coherent.mean)}</td>
            <td>{pct(SV[v].all.why.mean)}</td>
            <td>{pct(SV[v].all.sources.mean)}</td>
            <td>{pct(SV[v].all.length.mean)}</td>
            <td>{SV[v].macs_per_token.ledger ? kmacs(SV[v].macs_per_token.ledger) : '0'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : chart === 'cost' ? (
    <table class="cx-table">
      <thead>
        <tr>
          <th>model</th>
          <th>coherent</th>
          <th>keys attended per written token</th>
          <th>attention per token</th>
          <th>all operations per token</th>
        </tr>
      </thead>
      <tbody>
        {tableOrder.map((v) => {
          const c = V[v].macs_per_token;
          return (
            <tr>
              <td>{NAME[v]}</td>
              <td>{pct(V[v].all.coherent.mean)}</td>
              <td>{V[v].keys_per_token}</td>
              <td>{kmacs(c.attention)}{baseCost && v !== 'base' ? <small> ({c.attention <= baseCost.attention ? '−' : '+'}{Math.abs(Math.round((100 * (c.attention - baseCost.attention)) / baseCost.attention))}%)</small> : null}</td>
              <td>{kmacs(c.total)}{baseCost && v !== 'base' ? <small> ({c.total <= baseCost.total ? '−' : '+'}{Math.abs(Math.round((100 * (c.total - baseCost.total)) / baseCost.total))}%)</small> : null}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  ) : chart === 'monitors' ? (
    <table class="cx-table">
      <thead>
        <tr>
          <th>monitor</th>
          {tableOrder.map((v) => <th>{NAME[v]}</th>)}
        </tr>
      </thead>
      <tbody>
        {MON.map((m) => (
          <tr>
            <td>{MON_LABEL[m]}</td>
            {tableOrder.map((v) => {
              const s = V[v].all[m] as S;
              return <td>{s ? `${pct(s.mean)}` : '·'}{s && s.n > 1 ? <small> ±{Math.round(s.sd * 100)}</small> : null}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  ) : (
    <figure class="cx-results">
      {chart === 'bars' && (
        <svg viewBox={`0 0 ${W} ${40 + bars.length * 44}`} role="img" aria-label="Share of coherent posts per model">
          {[0, 0.25, 0.5, 0.75, 1].map((t) => (
            <g>
              <line x1={bx(t)} x2={bx(t)} y1="18" y2={24 + bars.length * 44} class="grid" />
              <text x={bx(t)} y="12" class="tick" text-anchor="middle">{pct(t)}</text>
            </g>
          ))}
          {bars.map((b) => (
            <g transform={`translate(0 ${26 + b.i * 44})`}>
              <text x="222" y="13" text-anchor="end" class="lab">{NAME[b.v]}</text>
              {b.all && <rect x={bx(0)} y="2" width={bx(b.all.mean) - bx(0)} height="14" style={`fill:${COLOR[b.v]}`} />}
              {b.all && <line x1={bx(b.all.min)} x2={bx(b.all.max)} y1="9" y2="9" class="whisk" />}
              {b.all && <text x={bx(Math.max(b.all.mean, b.all.max)) + 6} y="14" class="val">{pct(b.all.mean)}</text>}
              {b.conf && <rect x={bx(0)} y="20" width={bx(b.conf.mean) - bx(0)} height="8" class="conf" style={`fill:${COLOR[b.v]}`} />}
              {b.conf && <text x={bx(b.conf.mean) + 6} y="28" class="val val--dim">{pct(b.conf.mean)} when styles differ</text>}
            </g>
          ))}
        </svg>
      )}
      {chart === 'bylen' && (
        <svg viewBox={`0 0 ${W} ${270 + 17 * legendRows(lineVariants)}`} role="img" aria-label="Coherent share against requested length">
          {[0, 0.5, 1].map((t) => (
            <g>
              <line x1="60" x2={W - 40} y1={ky(t)} y2={ky(t)} class="grid" />
              <text x="50" y={ky(t) + 4} text-anchor="end" class="tick">{pct(t)}</text>
            </g>
          ))}
          {ks.map((k) => <text x={kx(k)} y="238" text-anchor="middle" class="tick">{k} ¶</text>)}
          <text x={(60 + W - 40) / 2} y="254" text-anchor="middle" class="tick">paragraphs requested</text>
          {lineVariants.map((v) => (
            <g>
              <path d={path(ks.map((k) => [kx(k), ky(V[v].by_k[k].coherent.mean)]))} class="line" style={`stroke:${COLOR[v]}`} />
              {ks.map((k) => <circle cx={kx(k)} cy={ky(V[v].by_k[k].coherent.mean)} r="3" style={`fill:${COLOR[v]}`} />)}
            </g>
          ))}
          {legend(lineVariants, 276).map((it) => (
            <g class="key">
              <line x1={it.x} x2={it.x + 16} y1={it.y - 4} y2={it.y - 4} style={`stroke:${COLOR[it.v]}`} />
              <text x={it.x + 22} y={it.y} class="lab">{NAME[it.v]}</text>
            </g>
          ))}
        </svg>
      )}
      {chart === 'hazard' && (
        <svg viewBox={`0 0 ${W} ${28 + kinds.length * (hzVariants.length * 16 + 22)}`} role="img" aria-label="Chance of breaking each invariant per opportunity">
          {kinds.map((k, ki) => (
            <g transform={`translate(0 ${16 + ki * (hzVariants.length * 16 + 22)})`}>
              <text x="0" y="10" class="lab">{KIND_LABEL[k]}</text>
              {hzVariants.map((v, j) => {
                const h = HZ[v][k];
                return (
                  <g transform={`translate(0 ${18 + j * 16})`}>
                    <text x="220" y="9" text-anchor="end" class="tick">{NAME[v]}</text>
                    <rect x={hx(0)} y="0" width={hx(h.hazard) - hx(0)} height="10" style={`fill:${COLOR[v]}`} />
                    <line x1={hx(h.ci[0])} x2={hx(h.ci[1])} y1="5" y2="5" class="whisk" />
                    <text x={hx(h.ci[1]) + 6} y="9" class="tick">{fmtHz(h.hazard)} · {h.breaks}/{h.opportunities}</text>
                  </g>
                );
              })}
            </g>
          ))}
        </svg>
      )}
      {chart === 'rising' && (
        <svg viewBox={`0 0 ${W} ${262}`} role="img" aria-label="Font hazard by paragraph">
          {[0, rMax / 2, rMax].map((t) => (
            <g>
              <line x1="80" x2={W - 60} y1={ry(t)} y2={ry(t)} class="grid" />
              <text x="70" y={ry(t) + 4} text-anchor="end" class="tick">{fmtHz(t)}</text>
            </g>
          ))}
          {bins.map((b, i) => <text x={rx(i)} y="228" text-anchor="middle" class="tick">{b.from === b.to ? `¶${b.from}` : `¶${b.from}–${b.to}`}</text>)}
          {['base', 'ledger'].filter((v) => HZ[v]).map((v) => (
            <g>
              <path d={path(HZ[v].font_by_paragraph.map((b: any, i: number) => [rx(i), ry(b.hazard)]))} class="line" style={`stroke:${COLOR[v]}`} />
              {HZ[v].font_by_paragraph.map((b: any, i: number) => <circle cx={rx(i)} cy={ry(b.hazard)} r="3.5" style={`fill:${COLOR[v]}`} />)}
            </g>
          ))}
          {legend(['base', 'ledger'].filter((v) => HZ[v]), 254).map((it) => (
            <g class="key">
              <line x1={it.x} x2={it.x + 16} y1={it.y - 4} y2={it.y - 4} style={`stroke:${COLOR[it.v]}`} />
              <text x={it.x + 22} y={it.y} class="lab">{NAME[it.v]}</text>
            </g>
          ))}
        </svg>
      )}
      {chart === 'attention' && (
        <svg viewBox={`0 0 ${W} 278`} role="img" aria-label="Attention on the example posts against output position">
          {[0, amax / 2, amax].map((t) => (
            <g>
              <line x1="60" x2={W - 40} y1={ay(t)} y2={ay(t)} class="grid" />
              <text x="50" y={ay(t) + 4} text-anchor="end" class="tick">{t.toFixed(2)}</text>
            </g>
          ))}
          {[0, 20, 40, 60, 80, 100].map((t) => <text x={ax(t)} y="238" text-anchor="middle" class="tick">{t}</text>)}
          <text x={(60 + W - 40) / 2} y="254" text-anchor="middle" class="tick">tokens written</text>
          {['base', 'ledger'].filter((v) => V[v]).map((v) => (
            <g>
              <path d={path(att(v).map((y, t) => [ax(t), ay(y)]))} class="line" style={`stroke:${COLOR[v]}`} />
            </g>
          ))}
          {legend(['base', 'ledger'].filter((v) => V[v]), 272).map((it) => (
            <g class="key">
              <line x1={it.x} x2={it.x + 16} y1={it.y - 4} y2={it.y - 4} style={`stroke:${COLOR[it.v]}`} />
              <text x={it.x + 22} y={it.y} class="lab">{NAME[it.v]}</text>
            </g>
          ))}
        </svg>
      )}
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .grid {
    stroke: rgba(22, 20, 15, 0.15);
  }
  .tick,
  .lab,
  .val {
    fill: var(--ink);
  }
  .tick {
    fill: var(--ink-2);
    font-size: 10px;
  }
  .val--dim {
    fill: var(--ink-2);
    font-size: 9.5px;
  }
  .conf {
    opacity: 0.45;
  }
  .whisk {
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .line {
    fill: none;
    stroke-width: 2;
  }
  .key line {
    stroke-width: 3;
  }
  .cx-table td small {
    font-weight: 400;
    opacity: 0.6;
  }
</style>
