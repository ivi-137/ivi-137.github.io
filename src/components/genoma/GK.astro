---
/** A Genoma knob: label, range, default and detents come from the global parameter table. */
import Knob from '../Knob.astro';
import { gspec } from '../../lib/genoma/params';

interface Props {
  id: string;
  size?: 'sm' | 'md' | 'lg';
  label?: string;
}
const { id, size = 'sm', label } = Astro.props;
const s = gspec(id);
if (!s) throw new Error(`unknown Genoma parameter ${id}`);
---

<Knob bind={id} label={label ?? s.label} min={s.min} max={s.max} step={s.step} value={s.def} size={size} format={s.fmt ?? (s.pos ? 'pos' : 'pct')} positions={s.pos} />
