---
import Base from '../../layouts/Base.astro';
import '../../styles/paper.css';
---

<Base title="You Need Coherence · paper" description="The paper version of “You need coherence”, available with a password.">
  <article class="sheet-wrap">
    <div class="sheet torn">
      <header class="sheet__head">
        <p class="kicker mono" data-decode>paper · password required</p>
        <h1 class="sheet__title">You Need Coherence</h1>
      </header>
      <div class="prose">
        <p>
          The argument of <a href="/posts/you-need-coherence/">the post</a>, written as a scientific paper: <em
            >You Need Coherence: The Rate at Which Transformers Break Their Promises, and How to Bound It</em
          >, by Gianni Pojani, with full proofs, tables and the experimental details.
        </p>
        <div class="lock" data-paper-lock data-src="/paper/you-need-coherence.pdf.enc" data-name="Pojani - You Need Coherence.pdf">
          <form>
            <label class="mono" for="paper-password">password</label>
            <div class="lock__row">
              <input id="paper-password" type="password" autocomplete="current-password" required />
              <button class="button" type="submit">Unlock</button>
            </div>
          </form>
          <p class="lock__status mono" data-paper-status aria-live="polite"></p>
          <p class="lock__links mono" data-paper-links hidden>
            <a data-paper-download href="#">download again</a> · <a href="#" target="_blank" rel="noopener">open in a new tab</a>
          </p>
        </div>
        <p class="lock__note">
          The file is decrypted in your browser (PBKDF2-SHA-256, AES-256-GCM); the password is not sent anywhere.
        </p>
      </div>
    </div>
  </article>
  <script>
    import { mountPaperLock } from '../../lib/paper-lock';
    document.addEventListener('astro:page-load', mountPaperLock);
  </script>
</Base>
