---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Zoo from '../components/Zoo.astro';
import { SITE } from '../lib/site';
import { getPosts } from '../lib/posts';
import { INSTRUMENTS } from '../lib/classes';
import Stamp from '../components/Stamp.astro';

const posts = await getPosts();
const latest = posts.slice(0, 9);
const TILTS = [-1.4, 1.1, -0.6, 1.7, -1.2, 0.7, -1.9, 1.3, -0.4];
---

<Base lifeMode="hero" lifeSeed="137" bodyClass="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__collage" data-parallax>
      <div class="cut cut--disc" data-depth="0.6" aria-hidden="true"></div>
      <div class="cut cut--bar" data-depth="0.25" aria-hidden="true"></div>

      <h1 id="hero-title" class="hero__title" data-depth="0.1">
        <span class="hero__word" aria-label={SITE.title}>
          {[...SITE.title].map((ch, i) => <span class:list={['ch', { 'ch--em': i === 1 }]} aria-hidden="true">{ch}</span>)}
        </span>
      </h1>

      <p class="cut cut--strip mono" data-depth="0.35" data-decode data-decode-delay="0.9">{SITE.tagline}</p>

      <div class="cut cut--card torn" data-depth="0.5">
        <p class="mono cut--card__head"><span>Specimen</span><span>Gianni Pojani</span></p>
        <p>
          Rule 137 is Rule 110 with black and white swapped: an automaton defined by eight bits that can compute <em>anything computable</em>.
        </p>
        <p class="mono cut--card__foot"><a href="/posts/rule-137/">Class IV · Turing-complete →</a></p>
      </div>
    </div>

    <p class="hero__hint mono" aria-hidden="true">
      <span>click · glider</span>
      <span>shift-click · glider gun</span>
      <span>drag · paint</span>
      <span>P · pause</span>
      <span>1–4 · rules</span>
    </p>
    <a class="hero__down mono" href="#transmissions">transmissions ↓</a>
  </section>

  <section id="transmissions" class="transmissions" aria-labelledby="tx-title">
    <header class="section-head">
      <h2 id="tx-title" class="section-head__title">Latest <em>transmissions</em></h2>
      <p class="section-head__aside mono">{posts.length} received · decoding ongoing</p>
    </header>
    <div class="collage-grid">
      {latest.map((post, i) => <Card post={post} tilt={TILTS[i % TILTS.length]} feature={i === 0} />)}
    </div>
    {
      posts.length > latest.length && (
        <p class="more">
          <a class="button" href="/archive/">
            All {posts.length} transmissions →
          </a>
        </p>
      )
    }
  </section>

  <section class="instruments" aria-labelledby="inst-title">
    <header class="section-head">
      <h2 id="inst-title" class="section-head__title">The <em>instruments</em></h2>
      <p class="section-head__aside mono">press ? anywhere for the manual</p>
    </header>
    <div class="instruments__grid">
      {
        INSTRUMENTS.map((t, i) => (
          <a class="instrument torn" href={t.url} style={`--tilt:${[-1.2, 0.9, -0.5, 1.4, -0.8][i % 5]}deg`}>
            <span class="instrument__glyph mono" aria-hidden="true">{t.glyph}</span>
            <b>{t.title.split(':')[0]}</b>
            <span>{t.why}</span>
            <Stamp id={t.class} link={false} />
          </a>
        ))
      }
      <button type="button" class="instrument torn" data-open-term style="--tilt:1.1deg">
        <span class="instrument__glyph mono" aria-hidden="true">~$</span>
        <b>Terminal</b>
        <span>A shell over the archive: ls, cat, grep, rule 110, neofetch, homeostat, K. Press ~.</span>
      </button>
    </div>
  </section>

  <section class="zoo-teaser" aria-labelledby="zoo-title">
    <div class="zoo-teaser__text">
      <p class="kicker mono" data-decode>taxonomy</p>
      <h2 id="zoo-title" class="section-head__title">The complexity <em>zoo</em></h2>
      <p>
        Posts here aren't sorted by tag. They're sorted by how hard they are to think through, using the nested classes of
        computational complexity theory. Start in <b>P</b> if you want something quick. <b>RE</b> is where the questions may
        never halt.
      </p>
      <p><a class="button" href="/archive/">Enter the zoo →</a></p>
    </div>
    <Zoo posts={posts} />
  </section>
</Base>
