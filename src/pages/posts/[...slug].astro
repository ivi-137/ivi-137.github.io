---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts } from '../../lib/posts';
import { backlinks, related } from '../../lib/graph';

export async function getStaticPaths() {
  const posts = await getPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, next: posts[i - 1], prev: posts[i + 1], related: related(post, posts), backlinks: backlinks(post, posts) },
  }));
}

const { post, prev, next, related: rel, backlinks: back } = Astro.props;
const { Content, headings } = await render(post);
---

<Post post={post} prev={prev} next={next} headings={headings} related={rel} backlinks={back}>
  <Content />
</Post>
