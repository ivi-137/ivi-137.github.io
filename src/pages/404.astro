---
import Base from '../layouts/Base.astro';
---

<Base title="Cell not found" lifeMode="hero" lifeSeed="404" bodyClass="lost">
  <section class="lost__box">
    <div class="sheet torn">
      <p class="kicker mono" data-decode>error · 404 · extinct</p>
      <h1 class="sheet__title">This cell has died.</h1>
      <p class="sheet__dek">
        It had fewer than two neighbours, and under B3/S23 that's final. Behind this card, the automaton is taking the number 404
        apart one generation at a time.
      </p>
      <p><a class="button" href="/">Return to the colony →</a></p>
    </div>
  </section>
</Base>
