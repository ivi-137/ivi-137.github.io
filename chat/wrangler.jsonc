{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gpojani-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Pages allowed to open a socket. Localhost is for `npm run dev` on the site.
    "ALLOWED_ORIGINS": "https://gpojani.me,https://www.gpojani.me,https://ivi-137.github.io,http://localhost:4321"
  }
  // Secret (not committed): ADMIN_TOKEN, for DELETE /history. Set with `npx wrangler secret put ADMIN_TOKEN`.
}
